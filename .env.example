# Backend API base URL for production deployments (e.g. Vercel, Netlify, Cloudflare Pages)
# Leave empty or omitted in local development to use the Vite proxy to http://localhost:3001
VITE_API_BASE_URL=

# Optional local proxy target override (default: http://localhost:3001)
VITE_API_PROXY_TARGET=http://localhost:3001

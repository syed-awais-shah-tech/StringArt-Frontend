# Backend API base URL for Cloud Run production deployment
# Example: https://stringart-backend-xyz.run.app
# Leave blank in local development to use local Vite dev server proxy
VITE_API_BASE_URL=https://your-backend-service.run.app

# Optional local dev proxy target override (default: http://localhost:3001)
VITE_API_PROXY_TARGET=http://localhost:3001
